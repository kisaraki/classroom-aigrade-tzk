# Copy to .env for local configuration. Never commit actual values.
# Phase 0 preview and smoke tests do not require production secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Choose an exact authorized URI after the D-09 platform path is confirmed.
GOOGLE_OAUTH_REDIRECT_URI=
ADMIN_BOOTSTRAP_SECRET=
ADMIN_RECOVERY_SECRET=
# Import runtime: HMAC Secret is a JSON array of version/base64 objects (all active versions).
IDENTITY_HMAC_SECRET=
# Encryption Secret is one JSON object with version and base64 (32 independent key bytes).
IDENTITY_ENCRYPTION_KEY=
# AI provider credentials are independent of administrator authentication.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Public lookup stays disabled until trusted edge IP and hourly cleanup are verified.
PUBLIC_LOOKUP_VERIFIED=false
AUTH_RATE_VERIFIED=false
AUTH_RATE_HMAC_SECRET=
# Dedicated independent high-entropy secret, at least 32 characters.
PUBLIC_LOOKUP_HMAC_SECRET=
